{
  "name": "@boobstrap/boobstrap",
  "version": "0.1.4",
  "description": "A cheeky CSS framework that still means business.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/boobstrap.css",
    "src"
  ],
  "style": "dist/boobstrap.css",
  "exports": {
    ".": "./dist/boobstrap.css",
    "./css": "./dist/boobstrap.css",
    "./dist/boobstrap.css": "./dist/boobstrap.css"
  },
  "scripts": {
    "build": "node scripts/build-framework.mjs",
    "test": "npm run build && npm run test:contract && npm run test:css && npm run test:browser && npm run test:package",
    "test:contract": "node scripts/verify-framework.mjs",
    "test:css": "csstree-validator dist/boobstrap.css",
    "test:browser": "node tests/browser.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build && npm run test:contract && npm run test:css",
    "prepare": "npm run build"
  },
  "keywords": [
    "css",
    "framework",
    "components",
    "utilities"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeroq/boobstrap-framework.git"
  },
  "homepage": "https://boobstrap.org/docs.html",
  "bugs": {
    "url": "https://github.com/mikeroq/boobstrap-framework/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "csstree-validator": "^4.0.1",
    "playwright": "^1.62.1"
  }
}
