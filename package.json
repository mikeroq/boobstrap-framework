{
  "name": "@boobstrap/boobstrap",
  "version": "0.7.0",
  "description": "A cheeky CSS framework that still means business.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "boobstrap": "./bin/boobstrap.mjs"
  },
  "files": [
    "bin",
    "dist/boobstrap.css",
    "dist/boobstrap.min.css",
    "dist/boobstrap.min.css.map",
    "dist/boobstrap.js",
    "dist/boobstrap.d.ts",
    "dist/compiler.js",
    "dist/compiler.d.ts",
    "dist/schema.json",
    "dist/tokens.json",
    "dist/tokens.js",
    "dist/tokens.d.ts",
    "dist/js",
    "CHANGELOG.md",
    "docs/INTERACTIONS.md",
    "docs/MIGRATING.md",
    "docs/VERSIONING.md",
    "src"
  ],
  "style": "dist/boobstrap.css",
  "exports": {
    ".": "./dist/boobstrap.css",
    "./css": "./dist/boobstrap.css",
    "./min.css": "./dist/boobstrap.min.css",
    "./dist/boobstrap.css": "./dist/boobstrap.css",
    "./schema.json": "./dist/schema.json",
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./js": {
      "types": "./dist/boobstrap.d.ts",
      "default": "./dist/boobstrap.js"
    },
    "./js/accordion": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/accordion.js"
    },
    "./js/banner": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/banner.js"
    },
    "./js/button": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/button.js"
    },
    "./js/collapse": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/collapse.js"
    },
    "./js/combobox": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/combobox.js"
    },
    "./js/command-palette": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/command-palette.js"
    },
    "./js/dropdown": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/dropdown.js"
    },
    "./js/dialog": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/dialog.js"
    },
    "./js/input-mask": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/input-mask.js"
    },
    "./js/navbar": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/navbar.js"
    },
    "./js/otp": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/otp.js"
    },
    "./js/password": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/password.js"
    },
    "./js/popover": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/popover.js"
    },
    "./js/scrollspy": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/scrollspy.js"
    },
    "./js/sidebar": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/sidebar.js"
    },
    "./js/tabs": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/tabs.js"
    },
    "./js/toast": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/toast.js"
    },
    "./js/tooltip": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/tooltip.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.json": "./dist/tokens.json"
  },
  "scripts": {
    "build": "node scripts/build-framework.mjs",
    "test": "npm run build && npm run test:contract && npm run test:conformance && npm run test:compiler && npm run test:docs && npm run test:css && npm run test:size && npm run test:browser && npm run test:visual && npm run test:package && npm run test:starter",
    "test:contract": "node scripts/verify-framework.mjs",
    "test:size": "node scripts/verify-size.mjs",
    "test:conformance": "node scripts/verify-interaction-contract.mjs",
    "test:compiler": "node tests/compiler.mjs",
    "test:docs": "node scripts/verify-docs.mjs",
    "test:css": "csstree-validator dist/boobstrap.css",
    "test:browser": "node tests/browser.mjs && node tests/rtl.mjs && node tests/a11y.mjs && node tests/interactions.mjs && node tests/alpine.mjs && node tests/react.mjs && node tests/vue.mjs && node tests/svelte.mjs",
    "test:visual": "node tests/visual.mjs",
    "test:visual:update": "UPDATE_VISUAL=1 node tests/visual.mjs",
    "test:package": "node scripts/verify-package.mjs && node scripts/verify-alpine-package.mjs && node scripts/verify-react-package.mjs && node scripts/verify-vue-package.mjs && node scripts/verify-svelte-package.mjs && npm run test:types",
    "test:types": "tsc --noEmit --strict --jsx react-jsx --module NodeNext --moduleResolution NodeNext --target ES2022 --lib ES2022,DOM --skipLibCheck tests/core-types.ts tests/alpine-types.ts tests/react-types.tsx tests/vue-types.ts tests/svelte-types.ts",
    "test:starter": "npm --prefix examples/starter ci && npm --prefix examples/starter run validate",
    "prepack": "npm run build && npm run test:contract && npm run test:css",
    "prepare": "npm run build"
  },
  "keywords": [
    "css",
    "framework",
    "components",
    "utilities"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeroq/boobstrap-framework.git"
  },
  "homepage": "https://boobstrap.org/docs",
  "bugs": {
    "url": "https://github.com/mikeroq/boobstrap-framework/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "devDependencies": {
    "@alpinejs/csp": "^3.15.12",
    "@axe-core/playwright": "^4.12.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "alpinejs": "^3.15.12",
    "csstree-validator": "^4.0.1",
    "esbuild": "^0.28.1",
    "pixelmatch": "7.1.0",
    "playwright": "^1.62.1",
    "pngjs": "7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svelte": "^5.56.10",
    "typescript": "^7.0.2",
    "vue": "^3.5.0"
  }
}
